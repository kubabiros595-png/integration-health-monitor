    {
      "id": "fefb687a-2a7e-4356-8fb2-48a2b75031dd",
      "name": "Generate demo request log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Request log for the last 24 hours: one \"accepted\" row per demo event,\n// plus Tallowick's rejected requests every 5 min since its secret \"changed\" 50 min ago, and a few normal retries.\nconst NOW = Date.now();\nconst MIN = 60000;\nconst events = $('Generate demo events').all().map(i => i.json).filter(e => new Date(e.received_at).getTime() > NOW - 1440 * MIN);\nconst out = events.map(e => ({ json: { received_at: e.received_at, shop_id: e.shop_id, event_id: e.event_id, outcome: 'accepted', http_status: 200, reason: '', test_run: '', source: 'demo' } }));\nfor (let m = 50; m >= 5; m -= 5) out.push({ json: { received_at: new Date(NOW - m * MIN).toISOString(), shop_id: 'shop_tallowick', event_id: '', outcome: 'rejected_signature', http_status: 401, reason: 'signature does not match', test_run: '', source: 'demo' } });\nfor (const e of events.filter(x => x.shop_id === 'shop_mossbank').slice(0, 3)) out.push({ json: { received_at: e.received_at, shop_id: e.shop_id, event_id: e.event_id, outcome: 'duplicate', http_status: 200, reason: 'event_id already processed, ignored', test_run: '', source: 'demo' } });\nreturn out;"
      },
      "executeOnce": true
    },
