    {
      "id": "e817c21b-6f33-448e-91c0-9e5dc6ae4d7f",
      "name": "Generate demo events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Fictional 7-day history written straight to the tables (not through the webhook).\n// Mossbank: healthy, an event every 20 min.\n// Quillmoor: an event every 15 min, then nothing for the last 5 hours (silent integration).\n// Tallowick: an event every 20 min until 52 min ago, when its signing secret \"changed\": since then every request is rejected.\nconst NOW = Date.now();\nconst MIN = 60000;\nconst PLAN = [\n  { shop: 'shop_mossbank', gap: 20, lastAgo: 3 },\n  { shop: 'shop_quillmoor', gap: 15, lastAgo: 300 },\n  { shop: 'shop_tallowick', gap: 20, lastAgo: 52 }\n];\nconst out = [];\nlet n = 0;\nfor (const p of PLAN) {\n  for (let t = NOW - p.lastAgo * MIN; t > NOW - 7 * 1440 * MIN; t -= p.gap * MIN) {\n    n++;\n    const id = 'evt_DEMO' + p.shop.slice(5, 8).toUpperCase() + String(n).padStart(6, '0');\n    const type = n % 4 === 0 ? 'customer.updated' : 'order.created';\n    const at = new Date(t).toISOString();\n    out.push({ json: { event_id: id, shop_id: p.shop, event_type: type, occurred_at: at, received_at: at,\n      payload: JSON.stringify({ event_id: id, event_type: type, occurred_at: at, shop_id: p.shop, data: { note: 'fictional demo event' } }),\n      test_run: '', source: 'demo' } });\n  }\n}\nreturn out;"
      }
    },
