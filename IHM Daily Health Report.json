    {
      "id": "cb982dcf-6b09-4955-b613-e03887e828c6",
      "name": "Build one report per client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Plain numbers per client for the last 24 hours, plus a status a CSM can read in two seconds.\nconst rows = name => $(name).all().map(i => i.json).filter(r => r && r.id !== undefined);\nconst integrations = rows('Get integrations').filter(r => r.active !== false);\nconst events = rows('Get events of last 7 days');\nconst log = rows('Get requests of last 24 h');\nconst alerts = rows('Get open alerts');\nconst now = Date.now();\nconst fmt = d => new Date(d).toISOString().slice(0, 16).replace('T', ' ') + ' UTC';\nconst today = $now.setZone('Europe/Warsaw').toFormat('yyyy-MM-dd');\n\nreturn integrations.map(i => {\n  const mine = log.filter(r => r.shop_id === i.shop_id);\n  const accepted = mine.filter(r => r.outcome === 'accepted').length;\n  const duplicates = mine.filter(r => r.outcome === 'duplicate').length;\n  const rejectedRows = mine.filter(r => String(r.outcome).startsWith('rejected'));\n  const rejected = rejectedRows.length;\n  const rate = accepted + rejected ? Math.round(rejected / (accepted + rejected) * 1000) / 10 : 0;\n  const counts = {};\n  for (const r of rejectedRows) { const k = r.outcome.replace('rejected_', ''); counts[k] = (counts[k] || 0) + 1; }\n  const top = Object.entries(counts).sort((a, b) => b[1] - a[1])[0];\n  const times = events.filter(e => e.shop_id === i.shop_id).map(e => new Date(e.received_at).getTime());\n  const last = times.length ? Math.max(...times) : null;\n  const open = alerts.filter(a => a.shop_id === i.shop_id).length;\n  const hoursSince = last ? Math.floor((now - last) / 3600000) : null;\n\n  let status = 'Healthy';\n  if (rate > 5 || accepted === 0) status = 'Needs attention';\n  if (open > 0) status = 'Problem';\n\n  const parts = [];\n  parts.push(accepted + ' events accepted in 24 h');\n  if (rejected) parts.push(rejected + ' rejected (' + rate + '%), mostly ' + top[0]);\n  if (duplicates) parts.push(duplicates + ' duplicates ignored');\n  parts.push(last ? 'last event ' + (hoursSince < 1 ? 'less than 1 h ago' : hoursSince + ' h ago') : 'no events in 7 days');\n  if (open) parts.push(open + ' alert(s) waiting for review');\n\n  return { json: {\n    report_date: today, shop_id: i.shop_id, shop_name: i.shop_name,\n    accepted_24h: accepted, duplicates_24h: duplicates, rejected_24h: rejected, error_rate_pct: rate,\n    last_event_at: last ? fmt(last) : 'none in 7 days', top_reject_reason: top ? top[0] + ' (' + top[1] + ')' : '',\n    open_alerts: open, status, summary: i.shop_name + ': ' + status + '. ' + parts.join(', ') + '.'\n  } };\n});"
      }
    },
